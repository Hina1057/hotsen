<div class="res-list-wrap">
  <h1 class="res-list-title">現在の予約情報</h1>


  <% if @reservations.empty? %>
    <div class="card notice-card">
      <p class="muted">予約はありません。</p>
      <div class="mypage-actions">
        <%= link_to "トップへ戻る", root_path, class: "btn-lite" %>
        <%= link_to "マイページへ戻る", account_path(current_account), class: "btn-lite" %>
      </div>
    </div>
  <% else %>
    <div class="res-cards">
      <% @reservations.each do |r| %>
        <div class="res-card">
          <div>
            <h3>
              <%= link_to r.hotel.name, hotel_path(r.hotel), style: "text-decoration:none; color:#111827;" %>
            </h3>

            <div class="muted">
              部屋：<%= r.room.room_type %>
            </div>

            <div class="res-meta">
              <span>チェックイン：<%= r.check_in_on %></span>
              <span>泊数：<%= r.stay_count %></span>
              <span>人数：<%= r.guest_count %></span>
              <span>朝食：<%= r.breakfast ? "あり" : "なし" %></span>
              <span>夕食：<%= r.dinner ? "あり" : "なし" %></span>
            </div>
          </div>

          <div class="res-side">
            <div class="res-price">
              <small>合計</small>
              <%= r.total_price %>円
            </div>

            <div style="display:flex; gap:10px; flex-wrap:wrap;">
              <%= link_to "詳細", reservation_path(r), class: "btn-lite" %>

              <%= button_to "キャンセル",
                    cancel_reservation_path(r),
                    method: :delete,
                    form: { data: { turbo: false }, onsubmit: "return confirm('この予約をキャンセルしますか？');" },
                    class: "btn-danger-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mypage-actions" style="margin-top:14px;">
      <%= link_to "マイページへ戻る", account_path(current_account), class: "btn-lite" %>
      <%= link_to "トップへ戻る", root_path, class: "btn-lite" %>
    </div>
  <% end %>
</div>