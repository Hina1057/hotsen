<div class="auth-wrap">
  <div class="auth-card">
    <h1 class="auth-title">新規会員登録</h1>
    <p class="auth-sub">登録後はログイン画面へ移動します。</p>

    

    <%= form_with model: @account, local: true do |f| %>
      <div class="form-grid">
        <div class="form-field">
          <%= f.label :name, "名前" %>
          <%= f.text_field :name, class: "input" %>
        </div>

        <div class="form-field">
          <%= f.label :email, "メールアドレス" %>
          <%= f.email_field :email, class: "input" %>
        </div>

        <div class="form-field">
          <%= f.label :address, "住所" %>
          <%= f.text_field :address, class: "input" %>
        </div>

        <div class="form-field">
          <%= f.label :birthday, "誕生日" %>
          <%= f.date_field :birthday, class: "input", max: Date.today %>
          <div class="field-hint">未来の日付は登録できません</div>
        </div>

        <div class="form-field">
          <%= f.label :sex, "性別" %>
          <%= f.select :sex,
      [["男性", "male"], ["女性", "female"]],
      {},
      class: "input" %>
        </div>

        <div class="form-field">
          <%= f.label :phone_number, "電話番号" %>
          <%= f.text_field :phone_number, class: "input" %>
        </div>

        <div class="form-field">
          <%= f.label :password, "パスワード" %>
          <%= f.password_field :password, class: "input", minlength: 5, maxlength: 30 %>
          <div class="field-hint">5文字以上30文字以下</div>
        </div>

        <div class="form-field">
          <%= f.label :password_confirmation, "パスワード（確認）" %>
          <%= f.password_field :password_confirmation, class: "input", minlength: 5, maxlength: 30 %>
        </div>
      </div>

      <div class="auth-actions">
        <%= f.submit "登録する", class: "btn btn--primary" %>
        <%= link_to "ログインへ戻る", new_session_path, class: "btn-lite" %>
      </div>
    <% end %>
  </div>
</div>