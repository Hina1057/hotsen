<h1>予約一覧（管理者）</h1>

<table>
  <thead>
    <tr>
      <th>予約者</th>
      <th>ホテル</th>
      <th>部屋</th>
      <th>チェックイン</th>
      <th>泊数</th>
      <th>人数</th>
      <th>合計</th>
      <th>作成日</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @reservations.each do |r| %>
      <tr>
        <td><%= r.account.name %></td>
        <td><%= r.hotel.name %></td>
        <td><%= r.room.room_type %></td>
        <td><%= r.check_in_on %></td>
        <td><%= r.stay_count %></td>
        <td><%= r.guest_count %></td>
        <td><%= r.total_price %></td>
        <td><%= r.created_at.to_date %></td>
        <td>
        <%= link_to "詳細", admin_reservation_path(r) %>
        <%= button_to "削除",
        admin_reservation_path(r),
        method: :delete,
        data: { confirm: "この予約を削除しますか？" } %>
        </td>

      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "管理者トップへ戻る", admin_root_path %></p>
