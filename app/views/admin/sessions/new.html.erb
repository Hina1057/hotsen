<h1>管理者ログイン</h1>



<%= form_with url: admin_session_path, method: :post, local: true do %>
  <div class="form-field">
    <label>名前</label>
    <%= text_field_tag :name %>
  </div>

  <div class="form-field">
    <label>パスワード</label>
    <%= password_field_tag :password %>
  </div>

  <%= submit_tag "ログイン", class: "btn btn--primary" %>
<% end %>