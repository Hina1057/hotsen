<h1>お知らせ新規作成</h1>

<% if @information.errors.any? %>
  <ul>
    <% @information.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with url: admin_informations_path, method: :post, local: true do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :body, "本文" %><br>
    <%= f.text_area :body, rows: 8 %>
  </div>

  <%= f.submit "作成する" %>
<% end %>

<p><%= link_to "一覧へ戻る", admin_informations_path %></p>
