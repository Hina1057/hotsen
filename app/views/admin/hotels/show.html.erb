<h1>ホテル詳細（管理者）</h1>
<%= button_to "削除",
            admin_hotel_path(@hotel),
            method: :delete,
            form: { onsubmit: "return confirm('削除します。よろしいですか？');" } %>
        </td>
<p><%= link_to "編集", edit_admin_hotel_path(@hotel) %></p>



<p>ホテル名: <%= @hotel.name %></p>
<p>エリア: <%= @hotel.area %></p>
<p>住所: <%= @hotel.address %></p>
<p>電話: <%= @hotel.phone_number %></p>
<p>駐車可能台数：<%= @hotel.parking_capacity %></p>

<hr>

<h3>設備・サービス</h3>

<ul>
  <% if @hotel.wifi %><li>Wi-Fi</li><% end %>
  <% if @hotel.large_bath %><li>大浴場</li><% end %>
  <% if @hotel.openair_bath %><li>露天風呂</li><% end %>
  <% if @hotel.sauna %><li>サウナ</li><% end %>
  <% if @hotel.bedrock_bath %><li>岩盤浴</li><% end %>
  <% if @hotel.barrier_free %><li>バリアフリー</li><% end %>
  <% if @hotel.smoking_area %><li>喫煙所</li><% end %>
</ul>

<h3>ホテル説明</h3>

<% if @hotel.information.present? %>
  <p><%= simple_format(@hotel.information) %></p>
<% end %>

<h2>部屋一覧</h2>

<p><%= link_to "部屋を追加", new_admin_hotel_room_path(@hotel) %></p>

<% if @rooms.any? %>
  <table>
    <thead>
      <tr>
        <th>タイプ</th>
        <th>定員</th>
        <th>価格</th>
        <th>在庫</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @rooms.each do |r| %>
        <tr>
          <td><%= r.room_type %></td>
          <td><%= r.max_person %></td>
          <td><%= r.room_price %></td>
          <td><%= r.room_stock %></td>
          <td>
            <%= link_to "編集", edit_admin_hotel_room_path(@hotel, r) %>
            <%= button_to "削除", admin_hotel_room_path(@hotel, r), method: :delete, data: { confirm: "削除しますか？" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>部屋がありません。</p>
<% end %>

<hr>

<h2>このホテルの予約一覧</h2>

<% if @reservations.any? %>
  <table>
    <thead>
      <tr>
        <th>予約ID</th>
        <th>予約者</th>
        <th>メール</th>
        <th>部屋</th>
        <th>チェックイン</th>
        <th>泊数</th>
        <th>人数</th>
        <th>合計</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @reservations.each do |r| %>
        <tr>
          <td><%= r.id %></td>
          <td><%= r.account.name %></td>
          <td><%= r.account.email %></td>
          <td><%= r.room.room_type %></td>
          <td><%= r.check_in_on %></td>
          <td><%= r.stay_count %></td>
          <td><%= r.guest_count %></td>
          <td><%= r.total_price %>円</td>
          <td><%= link_to "予約詳細", admin_reservation_path(r) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>このホテルの予約はありません。</p>
<% end %>


<p><%= link_to "ホテル一覧へ戻る", admin_hotels_path %></p>
