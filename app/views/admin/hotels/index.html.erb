<h1>ホテル一覧（管理者）</h1>
<% if flash[:alert].present? %>
  <p><%= flash[:alert] %></p>
<% end %>

<% if flash[:notice].present? %>
  <p><%= flash[:notice] %></p>
<% end %>
<p><%= link_to "ホテルを追加", new_admin_hotel_path %></p>


<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>ホテル名</th>
      <th>エリア</th>
      <th>電話番号</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @hotels.each do |hotel| %>
      <tr>
        <td><%= hotel.id %></td>
        <td><%= link_to hotel.name, admin_hotel_path(hotel) %></td>
        <td><%= hotel.area %></td>
        <td><%= hotel.phone_number %></td>
        <td>
          <%= button_to "削除",
            admin_hotel_path(hotel),
            method: :delete,
            form: { onsubmit: "return confirm('削除します。よろしいですか？');" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "管理者トップへ戻る", admin_root_path %></p>
