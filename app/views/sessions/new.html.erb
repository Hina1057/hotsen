<h1>ログイン</h1>

<% if flash[:alert].present? %>
  <p><%= flash[:alert] %></p>
<% end %>

<%= form_with url: session_path, method: :post do |f| %>
  <div>
    <label>アカウント名</label><br>
    <%= text_field_tag :name %>
  </div>

  <div>
    <label>パスワード</label><br>
    <%= password_field_tag :password %>
  </div>

  <%= f.submit "ログイン" %>
<% end %>

<p><%= link_to "新規会員登録", new_account_path %></p>
<p><%= link_to "トップへ戻る", root_path %></p>
