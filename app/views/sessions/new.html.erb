<div class="auth-wrap">
  <div class="auth-card">
    <h1 class="auth-title">ログイン</h1>
    <p class="auth-sub">メールアドレスとパスワードでログインします。</p>

    <% if flash[:alert].present? %>
      <div class="errors-box"><%= flash[:alert] %></div>
    <% end %>

    <% if flash[:notice].present? %>
      <div class="errors-box"><%= flash[:notice] %></div>
    <% end %>

    <%= form_with url: session_path, method: :post, local: true do %>
      <div class="form-grid">
        <div class="form-field">
          <label>メールアドレス</label>
          <%= email_field_tag :email, params[:email], class: "input" %>
        </div>

        <div class="form-field">
          <label>パスワード</label>
          <%= password_field_tag :password, nil, class: "input" %>
        </div>
      </div>

      <div class="auth-actions">
        <%= submit_tag "ログインする", class: "btn btn--primary" %>
        <%= link_to "新規会員登録へ", new_account_path, class: "btn-lite" %>
      </div>
    <% end %>
  </div>
</div>