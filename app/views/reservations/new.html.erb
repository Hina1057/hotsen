<h1>予約画面</h1>
<h2><%= @hotel.name %></h2>

<% if flash[:alert].present? %>
  <p><%= flash[:alert] %></p>
<% end %>

<% if @reservation.errors.any? %>
  <ul>
    <% @reservation.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: [@hotel, @reservation],
              url: confirm_hotel_reservations_path(@hotel),
              method: :post do |f| %>

  <div>
    <%= f.label :room_id, "部屋を選択" %><br>
    <%= f.collection_select :room_id, @rooms, :id, :label, include_blank: "選択してください" %>
  </div>

  <div>
    <%= f.label :check_in_on, "チェックイン日" %><br>
    <%= f.date_field :check_in_on %>
  </div>

  <div>
    <%= f.label :stay_count, "宿泊数" %><br>
    <%= f.number_field :stay_count, min: 1 %>
  </div>

  <div>
    <%= f.label :guest_count, "人数" %><br>
    <%= f.number_field :guest_count, min: 1 %>
  </div>

  <div>
    <%= f.label :pay_method, "支払い方法" %><br>
    <%= f.select :pay_method,
                 [["現地払い", 0], ["クレジット", 1]],
                 include_blank: "選択してください" %>
  </div>

  <div>
    <%= f.check_box :breakfast %>
    <%= f.label :breakfast, "朝食を付ける（＋1,000円 / 泊）" %>
  </div>

  <div>
    <%= f.check_box :dinner %>
    <%= f.label :dinner, "夕食を付ける（＋2,000円 / 泊）" %>
  </div>

  <%= f.submit "予約内容を確認する" %>
<% end %>

<p><%= link_to "ホテル詳細へ戻る", hotel_path(@hotel) %></p>
