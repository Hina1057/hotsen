<h1><%= @hotel.name %></h1>

<p>エリア：<%= @hotel.area %></p>
<p>住所：<%= @hotel.address %></p>
<p>電話：<%= @hotel.phone_number %></p>

<hr>
<%= link_to "このホテルを予約する",
    new_hotel_reservation_path(@hotel,
      check_in_on: params[:check_in_on],
      stay_count: params[:stay_count],
      guest_count: params[:guest_count]
    ) %>

<h3>設備・サービス</h3>

<ul>
  <% if @hotel.wifi %><li>Wi-Fi</li><% end %>
  <% if @hotel.large_bath %><li>大浴場</li><% end %>
  <% if @hotel.openair_bath %><li>露天風呂</li><% end %>
  <% if @hotel.sauna %><li>サウナ</li><% end %>
  <% if @hotel.bedrock_bath %><li>岩盤浴</li><% end %>
  <% if @hotel.barrier_free %><li>バリアフリー</li><% end %>
  <% if @hotel.smoking_area %><li>喫煙所</li><% end %>
</ul>

<h3>ホテル説明</h3>

<% if @hotel.information.present? %>
  <p><%= simple_format(@hotel.information) %></p>
<% end %>

<h2>部屋一覧</h2>
<% if @rooms.any? %>
  <ul>
    <% @rooms.each do |room| %>
      <li>
        部屋タイプ：<%= room.room_type %> /
        定員：<%= room.max_person %> /
        料金：<%= room.room_price %> /
        在庫：<%= room.room_stock %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>部屋情報がありません。</p>
<% end %>

<p><%= link_to "一覧へ戻る", hotels_path(area: params[:area], check_in_on: params[:check_in_on], stay_count: params[:stay_count], guest_count: params[:guest_count]) %></p>
