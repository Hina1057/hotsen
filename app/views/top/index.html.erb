<h1>トップ</h1>
<% if flash[:alert].present? %>
  <p><%= flash[:alert] %></p>
<% end %>
<hr>

<h2>検索</h2>
<%= form_with url: hotels_path, method: :get do %>
  <div>
    <label>エリア</label>
    <%= text_field_tag :area, params[:area] %>
  </div>

  <div>
    <label>チェックイン日</label>
    <%= date_field_tag :check_in_on, params[:check_in_on] %>
  </div>

  <div>
    <label>宿泊数</label>
    <%= number_field_tag :stay_count, (params[:stay_count] || 1), min: 1 %>
  </div>

  <div>
    <label>人数</label>
    <%= number_field_tag :guest_count, (params[:guest_count] || 1), min: 1 %>
  </div>
  
  <h3>設備条件</h3>

<div><%= check_box_tag :wifi, "1", params[:wifi].present? %> Wi-Fi</div>
<div><%= check_box_tag :large_bath, "1", params[:large_bath].present? %> 大浴場</div>
<div><%= check_box_tag :openair_bath, "1", params[:openair_bath].present? %> 露天風呂</div>
<div><%= check_box_tag :sauna, "1", params[:sauna].present? %> サウナ</div>
<div><%= check_box_tag :bedrock_bath, "1", params[:bedrock_bath].present? %> 岩盤浴</div>
<div><%= check_box_tag :barrier_free, "1", params[:barrier_free].present? %> バリアフリー</div>
<div><%= check_box_tag :smoking_area, "1", params[:smoking_area].present? %> 喫煙所</div>

  <%= submit_tag "検索する" %>
<% end %>

<p><%= link_to "FAQ", faq_path %></p>



<% if logged_in? %>
<hr>
<h2>アカウント</h2>
  <p>ログイン中：<%= current_account.name %></p>
  <p><%= link_to "マイページ", account_path(current_account) %></p>
<% end %>


<hr>

<h2>サイトからのお知らせ</h2>
<% if @informations.any? %>
  <ul>
    <% @informations.each do |info| %>
      <li>
        <%= link_to info.title, information_path(info) %>
        （<%= info.created_at.to_date %>）
      </li>
    <% end %>
  </ul>
  <%= link_to "お知らせ一覧へ", informations_path %>
<% else %>
  <p>お知らせはまだありません。</p>
<% end %>
