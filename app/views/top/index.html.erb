<h1>トップ</h1>
<% if flash[:alert].present? %>
  <p><%= flash[:alert] %></p>
<% end %>
<hr>

<h2>検索</h2>
<%= form_with url: hotels_path, method: :get do %>
  <div>
    <label>エリア</label>
    <%= text_field_tag :area, params[:area] %>
  </div>

  <div>
    <label>チェックイン日</label>
    <%= date_field_tag :check_in_on, params[:check_in_on] %>
  </div>

  <div>
    <label>宿泊数</label>
    <%= number_field_tag :stay_count, (params[:stay_count] || 1), min: 1 %>
  </div>

  <div>
    <label>人数</label>
    <%= number_field_tag :guest_count, (params[:guest_count] || 1), min: 1 %>
  </div>

  <%= submit_tag "検索する" %>
<% end %>

<p><%= link_to "FAQ", faq_path %></p>
<hr>

<h2>ログイン</h2>
<% if logged_in? %>
  <p>ログイン中：<%= current_account.name %></p>
  <%= button_to "ログアウト", session_path, method: :delete %>
  <p><%= link_to "マイページ", account_path(current_account) %></p>
<% else %>
  <%= link_to "ログイン画面へ", new_session_path %>
  <%= link_to "新規会員登録", new_account_path %>
<% end %>


<hr>

<h2>サイトからのお知らせ</h2>
<% if @informations.any? %>
  <ul>
    <% @informations.each do |info| %>
      <li>
        <%= link_to info.title, information_path(info) %>
        （<%= info.created_at.to_date %>）
      </li>
    <% end %>
  </ul>
  <%= link_to "お知らせ一覧へ", informations_path %>
<% else %>
  <p>お知らせはまだありません。</p>
<% end %>
