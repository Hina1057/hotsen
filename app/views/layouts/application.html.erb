<!DOCTYPE html>
<html>
  <head>
    <title>Hotsen</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "application", defer: true %>
  </head>

  <body>
  <header style="padding: 10px; border-bottom: 1px solid #ccc;">
    <%= link_to root_path, style: "text-decoration: none; display: flex; align-items: center;" do %>
      <%= image_tag "logo.png", alt: "アプリロゴ", style: "height: 40px; margin-right: 10px;" %>
      <span style="font-size: 20px; font-weight: bold; color: #333;">
        HotSen
      </span>
    <% end %>
  </header>

  <%= yield %>
</body>

</html>
